{
  "name": "@teloi/electron",
  "version": "0.0.0",
  "private": true,
  "description": "Electron wrapper for Teloi",
  "main": "out/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -F @teloi/web build && node scripts/build-main.mjs && electron-builder",
    "build:main": "node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.teloi.app",
    "productName": "Teloi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "renderer/**/*"
    ],
    "extraResources": [],
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0"
  }
}
